# AquaVision backend (Node dev server + Cloudflare Worker)
# Local dev: copy to backend/.env.   Production (Worker): set via `wrangler secret put <NAME>`
# for secrets, or `vars` in wrangler.jsonc for non-secret values. NEVER commit real values.

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Supabase (server-side only) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # SECRET. Never expose to the frontend.

# --- Email / SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=                            # SECRET
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=AquaVision

# --- OTP ---
OTP_PEPPER=                           # SECRET. REQUIRED in production, >= 32 random chars.
OTP_EXPIRY_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_LOCKOUT_SECONDS=3600
FORGOT_PASSWORD_DAILY_LIMIT=1

# --- External ML service (separate project; backend-only) ---
# Base URL of the deployed ML service (must expose GET /health and POST /enhance).
# REQUIRED in production; localhost values are rejected when NODE_ENV=production.
ML_SERVICE_URL=http://localhost:8000
# Per-request timeout for enhancement calls (default 120000)
ML_SERVICE_TIMEOUT_MS=120000
