# AquaVision frontend (Vite). Only PUBLIC values belong here: everything prefixed VITE_
# is embedded in the browser bundle. Never put secrets or ML credentials in this file.
VITE_API_URL=http://localhost:4000/api/v1

# NOT here: the mail function (frontend/api/send-email.js) reads EMAIL_USER, EMAIL_APP_PASSWORD and INTERNAL_API_KEY
# from the Vercel dashboard. They have no VITE_ prefix, so they are never sent to the browser.
