# AquaVision backend (Node dev server + Cloudflare Worker)
# Local dev: copy to backend/.env.   Production (Worker): set via `wrangler secret put <NAME>`
# for secrets, or `vars` in wrangler.jsonc for non-secret values. NEVER commit real values.

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Supabase (server-side only) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # SECRET. Never expose to the frontend.

# --- Email / SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=                            # SECRET
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=AquaVision

# --- OTP ---
OTP_PEPPER=                           # SECRET. REQUIRED in production, >= 32 random chars.
OTP_EXPIRY_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_LOCKOUT_SECONDS=3600
FORGOT_PASSWORD_DAILY_LIMIT=1

# --- External ML service (separate project; backend-only) ---
# Base URL of the deployed ML service (must expose GET /health and POST /enhance).
# REQUIRED in production; localhost values are rejected when NODE_ENV=production.
ML_SERVICE_URL=http://localhost:8000
# Per-request timeout for enhancement calls (default 120000)
ML_SERVICE_TIMEOUT_MS=120000

# --- External ML service (separate project hosted on Render; backend-only) ---
# Base URL only: no trailing slash and no /v1/enhance. Must be https:// in production.
AQUAVISION_ML_BASE_URL=https://aquavision-ml-service-cxf5.onrender.com
# Shared secret. The ML service stores the same value as AQUAVISION_API_KEY; the backend sends it as
# the X-API-Key header. Raw value only: no "Bearer", quotes, spaces or line breaks. SECRET.
AQUAVISION_ML_API_KEY=
# Overall wait for one enhancement, in seconds (covers Render cold starts). Default 180.
AQUAVISION_ML_TIMEOUT_SECONDS=180
# Also accepted: AQUAVISION_API_KEY (same name the ML service uses), ML_SERVICE_URL, ML_SERVICE_API_KEY, ML_SERVICE_TIMEOUT_MS.

# --- OTP e-mail via the Vercel mail function (Nodemailer + Gmail SMTP) --- recommended
# The Worker cannot make SMTP connections, so it posts the finished message to frontend/api/send-email on Vercel.
# Gmail credentials live ONLY in Vercel (EMAIL_USER, EMAIL_APP_PASSWORD). Use your FINAL custom domain here
# (not the vercel.app one: it redirects, and redirects are never followed because the secret travels with the call).
VERCEL_API_URL=https://aquavision.mohitbhutada.com
# Shared secret, identical on Vercel (INTERNAL_API_KEY) and here. >= 32 random characters. SECRET.
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=

