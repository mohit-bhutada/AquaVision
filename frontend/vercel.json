{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "https://aqua-vision-taupe.vercel.app" }],
      "destination": "https://aquavision.mohitbhutada.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://aquavision-backend-worker.aquavisionai01.workers.dev/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}